# radio/stream/.env — copy to .env and fill in. Never committed, never logged,
# never returned by /status.json. server.js reads it and passes the assembled
# RTMP urls to capture.js through the environment only.

# Twitch: Creator Dashboard → Settings → Stream → Primary Stream key
TWITCH_STREAM_KEY=live_000000000_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YouTube: Studio → Go live → Stream key
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# Optional: a different YouTube ingest (default rtmp://a.rtmp.youtube.com/live2)
# YOUTUBE_INGEST=rtmp://b.rtmp.youtube.com/live2?backup=1
